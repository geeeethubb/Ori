/**
 * Writes the pitch deck's static brand assets from the canonical sources, so the standalone /pitch/
 * page (client/public/pitch, served without the React app) shows the same Ori as the product.
 *
 *   npx tsx scripts/build-pitch-assets.mts
 *
 * Output (committed; re-run after shared/oriArt.ts, shared/icons.ts, shared/brand.ts or the fonts change):
 *   client/public/pitch/assets/ori/companion-<mood>.svg   oriCompanionSvg, the four expressions the deck uses
 *   client/public/pitch/assets/ori/wordmark-<variant>.svg oriWordmarkSvg, ink and cobalt
 *   client/public/pitch/assets/ori/app-icon.svg           oriAppIconSvg (Ori's own lilac tile)
 *   client/public/pitch/assets/ori/favicon.svg            oriFaviconDocument (the tab icon the app uses)
 *   client/public/pitch/assets/ori/app-<light|riff|people>.svg  the reference apps' canonical icons
 *   client/public/pitch/assets/fonts/*.woff2              Manrope and DM Sans (latin, variable; OFL)
 *   client/public/pitch/assets/yc-logo.png                the official YC mark from docs/ori-pitch-kit/assets
 *                                                          (see its SOURCES.md), shown only beside
 *                                                          the YC Summer 2027 application goal.
 *   client/public/pitch/assets/qr-ori.png                 the founder's supplied QR code (docs/ori-pitch-kit/assets),
 *                                                          copied byte for byte; it encodes https://ori-fjrx.onrender.com/
 *   client/public/pitch/assets/icons.js                   window.ORI_ICONS: the project's own icon set for the deck's
 *                                                          kit.icon(): every shared/icons.ts ICON_PATHS glyph ("app")
 *                                                          and the UI glyphs of client/src/components/ui.tsx Icons ("ui")
 *
 * The deck uses exactly four expressions of the identity board, each a canonical mood drawing:
 * Listening = attentive, Thinking = thinking, Found something = discovery, Ready = success. The files
 * are static drawings (no CSS motion); the deck crossfades between them. Companion files for other
 * moods are removed so the published folder holds only what the deck shows. The expressions tell the
 * pitch's story and never imply that Ori senses emotions.
 */
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { ORI_MOOD_LABELS, oriAppIconSvg, oriCompanionSvg, oriFaviconDocument, oriWordmarkSvg, type OriMood, type OriWordmarkVariant } from '../shared/oriArt.ts';
import { appIconSvg, ICON_PATHS } from '../shared/icons.ts';
import { REFERENCE_APP_ICONS, referenceIcon, type ReferenceAppKey } from '../shared/brand.ts';

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const PITCH = path.join(ROOT, 'client', 'public', 'pitch');
const ORI_DIR = path.join(PITCH, 'assets', 'ori');
const FONT_DIR = path.join(PITCH, 'assets', 'fonts');
const KIT_ASSETS = path.join(ROOT, 'docs', 'ori-pitch-kit', 'assets');

const BANNER = '<!-- Generated by scripts/build-pitch-assets.mts from the canonical Ori sources. Do not edit by hand. -->\n';

/** Companion drawings are vector; 256 keeps the full (not simplified) art at every size the deck uses. */
const COMPANION_PX = 256;
const WORDMARK_PX = 96;
const ICON_PX = 192;

/** The four expressions of the identity board, in the deck's order: Listening, Thinking, Found something, Ready. */
const DECK_MOODS: readonly OriMood[] = ['attentive', 'thinking', 'discovery', 'success'];

const written: string[] = [];
const removed: string[] = [];

function write(file: string, contents: string | Uint8Array): void {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, contents);
  written.push(path.relative(ROOT, file).split(path.sep).join('/'));
}

function writeSvg(name: string, svg: string): void {
  if (!svg.startsWith('<svg')) throw new Error(`${name}: expected an SVG document`);
  write(path.join(ORI_DIR, name), `${BANNER}${svg}\n`);
}

// The companion: one file per expression the deck shows, named after the canonical mood.
for (const mood of DECK_MOODS) {
  writeSvg(`companion-${mood}.svg`, oriCompanionSvg({ mood, size: COMPANION_PX }));
}
const expected = new Set(DECK_MOODS.map((mood) => `companion-${mood}.svg`));
for (const name of fs.readdirSync(ORI_DIR)) {
  if (/^companion-.+\.svg$/.test(name) && !expected.has(name)) {
    fs.rmSync(path.join(ORI_DIR, name));
    removed.push(name);
  }
}

// The wordmark on light surfaces.
const WORDMARKS: readonly OriWordmarkVariant[] = ['ink', 'cobalt'];
for (const variant of WORDMARKS) {
  writeSvg(`wordmark-${variant}.svg`, oriWordmarkSvg({ variant, height: WORDMARK_PX }));
}

// Ori's own icon and the tab icon.
writeSvg('app-icon.svg', oriAppIconSvg(512));
writeSvg('favicon.svg', oriFaviconDocument());

// The three reference apps of the demo story, with their canonical icons.
for (const key of Object.keys(REFERENCE_APP_ICONS) as ReferenceAppKey[]) {
  writeSvg(`app-${key}.svg`, appIconSvg(referenceIcon(key), ICON_PX));
}

// Self-hosted brand fonts (spec: Manrope headings, DM Sans body), latin subset, with their licences.
const FONTS = [
  { pkg: '@fontsource-variable/manrope', file: 'manrope-latin-wght-normal.woff2', out: 'manrope-latin-wght.woff2', licence: 'LICENSE-manrope.txt' },
  { pkg: '@fontsource-variable/dm-sans', file: 'dm-sans-latin-wght-normal.woff2', out: 'dm-sans-latin-wght.woff2', licence: 'LICENSE-dm-sans.txt' },
] as const;
for (const font of FONTS) {
  const dir = path.join(ROOT, 'node_modules', ...font.pkg.split('/'));
  const source = path.join(dir, 'files', font.file);
  if (!fs.existsSync(source)) throw new Error(`Missing ${font.pkg}/files/${font.file}; run npm install first.`);
  write(path.join(FONT_DIR, font.out), fs.readFileSync(source));
  write(path.join(FONT_DIR, font.licence), fs.readFileSync(path.join(dir, 'LICENSE')));
}

// The official YC mark, copied as supplied (docs/ori-pitch-kit/assets/SOURCES.md records its origin).
const ycLogo = path.join(KIT_ASSETS, 'yc-logo.png');
if (!fs.existsSync(ycLogo)) throw new Error('Missing docs/ori-pitch-kit/assets/yc-logo.png');
write(path.join(PITCH, 'assets', 'yc-logo.png'), fs.readFileSync(ycLogo));

// The founder's QR code for the closing slide, copied unchanged (no re-encoding, no overlay).
const qr = path.join(KIT_ASSETS, 'qr-ori.png');
if (!fs.existsSync(qr)) throw new Error('Missing docs/ori-pitch-kit/assets/qr-ori.png');
write(path.join(PITCH, 'assets', 'qr-ori.png'), fs.readFileSync(qr));

// The project's icon set for the deck (kit.icon in pitch.js): 24 x 24 line glyphs, stroke 2, round caps.
// "app" is every canonical app-icon glyph (shared/icons.ts); "ui" is the product's interface glyphs, read
// from the Icons object in client/src/components/ui.tsx (JSX whose children are plain SVG elements).
const uiSource = fs.readFileSync(path.join(ROOT, 'client', 'src', 'components', 'ui.tsx'), 'utf8');
const uiBlock = /export const Icons = \{([\s\S]*?)\n\};/.exec(uiSource)?.[1];
if (!uiBlock) throw new Error('client/src/components/ui.tsx: could not find "export const Icons = {"');
const uiIcons: Record<string, { body: string; fill?: true; strokeWidth?: number }> = {};
for (const m of uiBlock.matchAll(/^ {2}(\w+): \(\s*<svg ([^>]*)>([\s\S]*?)<\/svg>\s*\),?$/gm)) {
  const name = m[1] ?? '';
  const attrs = m[2] ?? '';
  const inner = m[3] ?? '';
  if (!name) continue;
  const body = inner.replace(/\s*\/>/g, '/>').replace(/>\s+</g, '><').trim();
  if (/[{}]/.test(body) || /\s[a-z]+[A-Z]\w*=/.test(body)) throw new Error(`ui.tsx Icons.${name}: unexpected JSX in the glyph`);
  const width = /strokeWidth="([\d.]+)"/.exec(attrs);
  uiIcons[name] = { body, ...(/fill="currentColor"/.test(attrs) ? { fill: true as const } : {}), ...(width && width[1] !== '2' ? { strokeWidth: Number(width[1]) } : {}) };
}
if (Object.keys(uiIcons).length < 30) throw new Error(`ui.tsx Icons: only ${Object.keys(uiIcons).length} glyphs parsed`);
const appIcons = Object.fromEntries(Object.entries(ICON_PATHS).map(([name, d]) => [name, { body: `<path d="${d}"/>` }]));
write(
  path.join(PITCH, 'assets', 'icons.js'),
  `// Generated by scripts/build-pitch-assets.mts from shared/icons.ts and client/src/components/ui.tsx. Do not edit by hand.\n` +
    `// The deck draws these with kit.icon(name): 24 x 24, stroke currentColor, stroke width 2, round caps and joins.\n` +
    `window.ORI_ICONS = ${JSON.stringify({ app: appIcons, ui: uiIcons })};\n`,
);

console.log(`[pitch-assets] expressions: ${DECK_MOODS.map((mood) => `${ORI_MOOD_LABELS[mood]} = ${mood}`).join(', ')}`);
console.log(`[pitch-assets] wrote ${written.length} files:\n  ${written.join('\n  ')}`);
if (removed.length) console.log(`[pitch-assets] removed companion files the deck no longer shows: ${removed.join(', ')}`);
