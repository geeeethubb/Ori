# Copy to .env — values here are dummies. Never commit real secrets.

# Server
PORT=8787
HOST=0.0.0.0
DATABASE_PATH=./data/app.db
# Public origin used in absolute links/instructions (set to your LAN or tunnel URL for phones)
PUBLIC_ORIGIN=http://localhost:8787
# Set to "true" behind HTTPS so the session cookie is Secure
COOKIE_SECURE=auto
# Extra allowed CORS origins (comma separated). Capacitor origins are always allowed.
CORS_ORIGINS=

# AI model adapter. "auto" = anthropic when ANTHROPIC_API_KEY is set, otherwise sample mode.
MODEL_PROVIDER=auto
ANTHROPIC_API_KEY=sk-ant-dummy-replace-me
ANTHROPIC_MODEL=claude-opus-5-5
MODEL_TIMEOUT_MS=45000
# Disclosed monthly fair-use allowance for AI generations per account
AI_GENERATION_ALLOWANCE=300

# Demo / sample data
SEED_DEMO_PASSWORD=demo-pass-2026

# Client (Vite, baked at build time). For the Android APK point this at a reachable server, not localhost.
VITE_API_BASE_URL=
